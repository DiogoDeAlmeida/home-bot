<Project>

  <PropertyGroup>
    <!-- Central Package Management : les versions vivent ici et nulle part ailleurs.
         Les .csproj ne portent que <PackageReference Include="..." />, sans Version. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Microsoft.Extensions — aligné sur .NET 10 (LTS, support jusqu'au 14/11/2028)">
    <!-- Aligné sur 10.0.11 par EF Core : le pinning transitif central refuse qu'une dépendance
         d'EF tire Microsoft.Extensions.* plus haut que ce qui est déclaré ici. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Persistance">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Discord (ADR-0008)">
    <!-- WebSocket entraîne Core et Rest en transitif : c'est le seul paquet nécessaire, la
         passerelle Gateway étant tenue à la main plutôt que par les modules Commands/Interactions,
         bâtis pour des commandes déclarées par attributs — les nôtres sont découvertes au
         démarrage depuis ICapabilityRegistry, pas connues à la compilation. -->
    <PackageVersion Include="Discord.Net.WebSocket" Version="3.20.1" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Éprouve le comportement HTTP du client qBittorrent lui-même — réauthentification sur
         403 — plutôt que la forme de ses réponses, que les fixtures couvrent déjà. -->
    <PackageVersion Include="WireMock.Net" Version="2.14.0" />
  </ItemGroup>

  <!-- Ajoutés aux étapes suivantes, volontairement absents ici : Serilog, Polly. -->

</Project>
