[Unit]
Description=Homelab Hub
Documentation=https://github.com/DiogoDeAlmeida/home-bot
After=network-online.target
Wants=network-online.target

# Bornent les tentatives de redémarrage de CETTE unité (Restart=, en [Service] plus bas) : au-delà
# de StartLimitBurst échecs dans la fenêtre StartLimitIntervalSec, systemd cesse de relancer et
# marque l'unité "failed" plutôt que de boucler.
#
# Ces deux clés appartiennent au [Unit], pas au [Service] — erreur commise dans une version
# précédente de ce fichier, où elles étaient sans effet silencieusement : une capacité mal
# déclarée (description trop longue pour Discord, HubConfigurationException dès le démarrage) a
# produit dix-neuf tentatives de redémarrage en quelques secondes sur le LXC jetable au lieu de
# s'arrêter après trois, exactement le scénario que ces deux lignes sont censées empêcher — ce
# test en conditions réelles est ce qui a débusqué le mauvais emplacement.
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=homelabhub
Group=homelabhub

# /opt/homelabhub/current est un lien symbolique vers releases/<version> — deploy/install.sh et
# deploy/update.sh le repointent, ce fichier ne change jamais d'une version à l'autre.
WorkingDirectory=/opt/homelabhub/current
ExecStart=/opt/homelabhub/current/homelabhub

# Restart=always, pas seulement on-failure : hub.service.restart (ADR-0019) arrête le processus
# proprement (code 0) pour appliquer un changement de configuration qui n'est lu qu'au démarrage
# (Discord, par exemple) — et on-failure ne relance jamais un arrêt propre, qu'il vienne d'un
# systemctl stop ou d'un appel interne à StopApplication(), les deux étant indiscernables de son
# point de vue. Ça reste sûr : systemd n'applique sa politique de redémarrage qu'aux arrêts que
# le processus déclenche lui-même — un `systemctl stop`/`disable` explicite reste respecté.
Restart=always
RestartSec=5

# Durcissement : ce processus détient les clés de tout le homelab (cadrage §3). Seuls les
# répertoires de données et de configuration sont accessibles en écriture ; le reste du
# système de fichiers reste en lecture seule à ses yeux.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/homelabhub/data /etc/homelabhub

# ProtectSystem=strict rend /tmp lecture seule comme le reste du système, sauf ici : un /tmp
# privé et réinscriptible, propre à cette unité. Trouvé manquant en conditions réelles — Data
# Protection y écrit sa toute première clé via un fichier temporaire, et /api/setup plantait dès
# le premier essai sur le LXC jetable (System.IO.IOException: Read-only file system : '/tmp/').
# AddHubInfrastructure (ADR-0019) repointe en plus TMPDIR vers le répertoire de données
# lui-même, pour que ce chemin ne dépende plus seulement de ce réglage-ci — les deux ne sont pas
# exclusifs.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
