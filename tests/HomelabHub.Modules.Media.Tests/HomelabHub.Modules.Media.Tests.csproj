<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HomelabHub.Modules.Media.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HomelabHub.Modules.Media\HomelabHub.Modules.Media.csproj" />
  </ItemGroup>

  <!-- Les fixtures sont copiées à côté de l'assembly de test : les tests désérialisent les
       vraies réponses des services, pas des mocks écrits à la main. -->
  <ItemGroup>
    <Content Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WireMock.Net viendra quand il faudra éprouver le comportement HTTP du client lui-même —
       délais, réessais, 403 de qBittorrent. Pour la forme des réponses, les fixtures suffisent
       et sont plus fidèles. -->

</Project>
