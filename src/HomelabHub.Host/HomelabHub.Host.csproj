<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>HomelabHub.Host</RootNamespace>
    <AssemblyName>homelabhub</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HomelabHub.Host.Tests" />
  </ItemGroup>

  <!-- Racine de composition : le seul projet exécutable, et le seul endroit qui connaisse
       à la fois l'adaptateur Discord et l'API web. Le bot tourne comme service d'arrière-plan
       dans ce processus : un binaire, une unité systemd, un packaging LXC simple. -->
  <ItemGroup>
    <ProjectReference Include="..\HomelabHub.Abstractions\HomelabHub.Abstractions.csproj" />
    <ProjectReference Include="..\HomelabHub.Core\HomelabHub.Core.csproj" />
    <ProjectReference Include="..\HomelabHub.Infrastructure\HomelabHub.Infrastructure.csproj" />
    <ProjectReference Include="..\HomelabHub.Discord\HomelabHub.Discord.csproj" />
    <ProjectReference Include="..\HomelabHub.Modules.System\HomelabHub.Modules.System.csproj" />
    <ProjectReference Include="..\HomelabHub.Modules.Media\HomelabHub.Modules.Media.csproj" />
  </ItemGroup>

  <!-- Build du front, injecté dans wwwroot par Vite (cf. web-ui/vite.config.ts).

       Conditionné à Release : `dotnet build` en développement reste rapide, et le front se
       lance à part avec `npm run dev`, qui proxifie /api vers ce Host. En Release, wwwroot est
       peuplé avant que le SDK ne calcule les fichiers à publier, ce qui suffit pour que
       `dotnet publish` embarque l'interface.

       `-p:SkipWebUi=true` court-circuite l'étape quand Node n'est pas disponible. -->
  <PropertyGroup>
    <WebUiDirectory>$(MSBuildProjectDirectory)/../../web-ui/</WebUiDirectory>
  </PropertyGroup>

  <Target Name="BuildWebUi" BeforeTargets="BeforeBuild"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipWebUi)' != 'true' AND Exists('$(WebUiDirectory)package.json')">
    <Exec Command="npm ci" WorkingDirectory="$(WebUiDirectory)"
          Condition="!Exists('$(WebUiDirectory)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(WebUiDirectory)" />
  </Target>

  <!-- Publication (étape 6) : pilotée par la ligne de commande et non par ce fichier, pour
       que `dotnet build` reste rapide en développement. Les options exactes sont dans
       .github/workflows/release.yml et documentées dans docs/03-deploiement.md.

       Options retenues : self-contained, single-file, ReadyToRun, runtime linux-x64.
       Options écartées : PublishTrimmed et PublishAot, parce qu'EF Core, Discord.Net et
       Serilog reposent sur la réflexion et cassent au découpage (ADR-0001) ; le binaire
       pèsera donc 90 à 130 Mo. EnableCompressionInSingleFile aussi, parce que le gain de
       taille se paie par une extraction sur disque à chaque démarrage.

       La sortie de web-ui/ sera injectée dans wwwroot/ par une cible MSBuild à l'étape 1. -->

</Project>
