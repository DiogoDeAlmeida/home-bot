<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HomelabHub.Core</RootNamespace>
  </PropertyGroup>

  <!-- Le noyau tourne toujours à l'intérieur du Host ASP.NET Core. Passer par le framework
       partagé plutôt que par des paquets NuGet évite d'épingler à la main des versions qui
       doivent de toute façon rester alignées sur le runtime. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomelabHub.Abstractions\HomelabHub.Abstractions.csproj" />
  </ItemGroup>

  <!-- Les implémentations du noyau sont internes : rien n'oblige un module ou un adaptateur à
       les connaître. Les tests, eux, les instancient directement. -->
  <ItemGroup>
    <InternalsVisibleTo Include="HomelabHub.Core.Tests" />
  </ItemGroup>

</Project>
