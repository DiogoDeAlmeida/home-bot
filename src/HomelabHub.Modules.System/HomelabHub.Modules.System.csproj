<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Volontairement pas « HomelabHub.Modules.System » : à l'intérieur d'un tel espace de
         noms, C# résout « System.IO » en « HomelabHub.Modules.System.IO » et tout casse de
         façon incompréhensible. Le nom d'assembly, lui, reste aligné sur le projet. -->
    <RootNamespace>HomelabHub.Modules.SystemInfo</RootNamespace>
  </PropertyGroup>

  <!-- RÈGLE STRUCTURANTE (ADR-0010) : un module ne référence QUE HomelabHub.Abstractions.
       Ajouter ici une référence vers Core, Infrastructure, Discord ou Host signifie que
       l'abstraction ne suffit pas — c'est l'abstraction qu'il faut corriger, pas la
       référence qu'il faut ajouter. Le test d'architecture fait échouer la CI. -->
  <ItemGroup>
    <ProjectReference Include="..\HomelabHub.Abstractions\HomelabHub.Abstractions.csproj" />
  </ItemGroup>

</Project>
